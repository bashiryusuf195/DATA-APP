# ── Customer App — environment variables ──────────────────────────────────
# Copy this file to .env (git-ignored) and fill in values.

# ── Error reporting (Sentry) ──────────────────────────────────────────────────
# Leave empty to disable (graceful no-op in dev without a DSN).
# Get from: sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# ── API base URL ──────────────────────────────────────────────────────────────
#
# Development (default): leave empty — Vite dev proxy routes /auth, /wallet,
#   /transactions, /services, /notifications, /referrals, /kyc, /public
#   to http://localhost:3000. No CORS configuration needed.
#
# Production: set to the full backend URL in Railway service env vars.
#   VITE_API_BASE_URL=https://api.hivedata.com.ng
#
# Direct local (no proxy): http://localhost:3000
VITE_API_BASE_URL=
