{
  "compilerOptions": {
    "target":                     "ES2022",
    "module":                     "commonjs",
    "lib":                        ["ES2022"],
    "outDir":                     "./dist",
    "rootDir":                    ".",
    "strict":                     true,
    "esModuleInterop":            true,
    "skipLibCheck":               true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule":          true,
    "declaration":                true,
    "sourceMap":                  true,
    "types":                      ["node"],
    "typeRoots":                  ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "tests/wallet/helpers.ts"],
  "exclude": ["node_modules", "dist"]
}
