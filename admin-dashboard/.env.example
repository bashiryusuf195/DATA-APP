# ── Admin Dashboard — environment variables ────────────────────────────────
# Copy this file to .env (git-ignored) and fill in values.

# API base URL
# Leave empty (recommended) to use the Vite dev proxy — no CORS config needed.
# Set to http://localhost:3000 for direct requests, but you must also add
# http://localhost:5173 to CORS_ORIGINS in the backend .env file.
VITE_API_BASE_URL=
