# ── Admin Dashboard — environment variables ────────────────────────────────
# Copy this file to .env (git-ignored) and fill in values.

# ── API base URL ──────────────────────────────────────────────────────────────
#
# Development (default): leave empty — Vite dev proxy routes /admin, /auth,
#   /wallet, /transactions, /notifications to http://localhost:3000.
#   No CORS configuration needed.
#
# Production: set to the full backend URL in Railway service env vars.
#   VITE_API_BASE_URL=https://api.hivedata.com.ng
#
# Direct local (no proxy): http://localhost:3000
#   Also add http://localhost:5173 to CORS_ORIGINS in the backend .env.
VITE_API_BASE_URL=
