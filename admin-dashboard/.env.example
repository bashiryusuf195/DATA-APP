# ── Admin Dashboard — environment variables ────────────────────────────────
# Copy this file to .env (git-ignored) and fill in values.

# ── Error reporting (Sentry) ──────────────────────────────────────────────────
# Leave empty to disable (graceful no-op in dev without a DSN).
# Get from: sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# ── API base URL ──────────────────────────────────────────────────────────────
#
# Development (default): leave empty — Vite dev proxy routes /admin, /auth,
#   /wallet, /transactions, /notifications to http://localhost:3000.
#   No CORS configuration needed.
#
# Production: set to the full backend URL in Railway service env vars.
#   VITE_API_BASE_URL=https://api.hivedata.com.ng
#
# Direct local (no proxy): http://localhost:3000
#   Also add http://localhost:5173 to CORS_ORIGINS in the backend .env.
VITE_API_BASE_URL=

# ── Firebase Web Push (admin dashboard push notifications) ────────────────────
# Required for the "Alerts" tab in Settings to register browser push tokens.
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
# VAPID key: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
#
# Leave all empty to disable browser push (backend push to mobile still works).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
