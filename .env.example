# ─────────────────────────────────────────────────────────────
# VTU Platform — Environment Variables
# Copy this file:  cp .env.example .env
# Fill in every value before running the server.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# NODE_ENV: development | production
NODE_ENV=development
PORT=3000
APP_NAME=vtu-api
APP_VERSION=1.0.0

# ── Supabase ─────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── PostgreSQL (direct — for Knex) ───────────────────────────
# Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_READ_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://default:TOKEN@host.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
# Dashboard → Settings → API → JWT Secret
JWT_SECRET=your-supabase-jwt-secret-here

# ── Encryption (PII: NIN, BVN) ───────────────────────────────
# Must be exactly 64 hex chars (= 32 bytes for AES-256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_chars_from_crypto_randombytes_32

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug

# ── VTPass ────────────────────────────────────────────────────
# Sandbox:    https://sandbox.vtpass.com/api
# Production: https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_USERNAME=your_username
VTPASS_PASSWORD=your_password
VTPASS_API_KEY=your_api_key
VTPASS_PUBLIC_KEY=your_public_key
VTPASS_SECRET_KEY=your_secret_key

# ── Paystack ──────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── Local PostgreSQL (docker compose --profile local-db only) ─────────────
# Not needed when pointing at Supabase / a remote database.
POSTGRES_DB=vtu_local
POSTGRES_USER=vtu
POSTGRES_PASSWORD=replace_with_strong_password
